[VR]
; Copy this file to DeusExHRVR.ini beside DXHRDC.exe. Keep the [VR] section.
; Restart the game after editing; this setting applies to tracked VR.
; Higher values = smaller apparent world, stronger close-range stereo depth.
; Lower values = larger apparent world, weaker close-range stereo depth.
; Also scales physical head translation. Accepted range: 10-1000.
WorldUnitsPerMetre=100

; Optional: keep mouse/gamepad aiming pitch out of the VR camera.
; The gun still aims vertically; headset pitch and horizontal look remain free.
; Virtual-screen modes retain the native camera. Restart to apply.
LockVerticalCamera=0

; Master switch for ALL right-controller features. 0 disables controller
; tracking, Xbox button emulation, weapon motion, and controller directions.
; Headset VR and Headset direction settings still work. Restart to apply.
MotionControls=1
; Optional full-headset scope with right-controller aiming; requires weapon motion.
ImmersiveScope=0
ScopeMagnification=4

; Left thumbstick click waits this long (ms) before a hold registers, so the
; two-stick weapon calibration chord doesn't also crouch. 0 sends it at once,
; for layouts that map the left click to something other than crouch.
LeftStickClickDelayMs=150

; Independent directions: Mouse, Headset, or Controller (right-hand aim).
; Mouse retains native mouse/gamepad look direction. Restart after editing.
; Interaction selects doors/items; it does not change weapon aiming.
InteractionAim=Mouse
; Walking uses horizontal heading only, including W/A/S/D and gamepad movement.
MovementDirection=Mouse
; Screen modes and missing tracking fall back to Mouse. Controller choices
; also work with ExperimentalMotionControls=0 and with the gun holstered,
; provided MotionControls=1. MotionControls=0 makes Controller use Mouse.

; Experimental right-controller weapon pose. Xbox button emulation works independently.
; Automatically falls back in screen modes or when controller tracking is lost.
ExperimentalMotionControls=0
; Hide the player's actor/arms mesh during controller aiming (experiment only).
ControllerHideArms=1
; Position the muzzle this far ahead of the controller aim pose (0-1 metre).
ControllerMuzzleForwardMetres=0.25

; Keep only heading (yaw) from the head pose captured when tracking starts and
; on F9, so a head tilted up or down at that moment does not tilt the world.
; Position, including height, is still captured. 0 restores the old behavior.
LevelRecenter=1
; The view freezes while the in-game menu (map, objectives, inventory) or a
; loading screen is up. Keep only the heading of that frozen pose so the screen
; is level instead of tilted with the head. 0 restores the old behavior.
LevelMenu=1
; Place the virtual screen (title and pause menus, terminals, videos) upright,
; 2 m straight ahead at head height, instead of tilted with the head.
; 0 restores the old behavior.
LevelScreen=1

; Take the VR rendering base from the game camera's heading and position only:
; the headset supplies all pitch and roll, including the walk animation's tilt.
; Aiming, the gun and virtual-screen modes are unaffected. Restart to apply.
YawOnlyCamera=0

; Take the camera height from the player's own origin plus a held eye height,
; instead of following the game camera. Removes the walk bounce and the stance
; height steps the game applies while crouch-walking (+15 units) and sprinting
; (-25), which show up as a bounce when you stop. Restart to apply.
StanceHold=0
; Gap that counts as a real stance change, in game units. Crouched and standing
; differ by about 300; gait offsets are 15-25 and walking bob is about 2.
; The view drops or rises through a real crouch or stand at the game's own
; transition speed.
StanceHoldTrigger=60

; Optional: keep the camera on the player's own path instead of following the
; run animation's side-to-side sway (about 1 cm, once per step). The value is
; the averaging window in milliseconds; 667 is one running stride. 0 disables.
SideSwayHoldMs=0

; Optional stutter fix from HRDCfix (github.com/imring/HRDCfix): a wait loop
; in the game sleeps a whole Windows timer tick (~15 ms) at a time; 1 makes it
; only yield instead. Needs no ASI loader when applied here.
SleepFix=0

; Optional filtering of the walk animation's left-right heading swing, in
; milliseconds; 0 disables each stage. Two cascaded stages (walking, then a
; second rhythm for sprinting). Needs YawOnlyCamera=1 to take effect.
; Suggested values: 667 / 526. Snap turns and other jumps pass through.
HeadSwayYawMs=0
HeadSwayYawMs2=0
; Largest heading correction allowed, in degrees.
HeadSwayYawLimit=1.5
; Write DeusExHRVR-bob.csv, one line per frame (camera position and heading,
; stick input, head pose) for measuring the walk animation. Costs frame time;
; leave at 0 for play.
BobTrace=0

; Snap turn: a horizontal right-stick flick turns the view instantly during
; gameplay instead of the stick's accelerating smooth turn. Menus, terminals
; and scoped aiming keep the native right stick.
SnapTurn=0
SnapTurnDegrees=30
; Size of the injected mouse move. Measured after each snap and rewritten here,
; so it self-calibrates from any starting value.
SnapTurnMouseCounts=300
; The game ignores mouse look while the left stick is deflected, so walking is
; released for at most this long around the injected move.
SnapTurnPauseMs=60
; Snap turn's mouse move brings up the PC quickbar. 1 turns on the game's own
; quickbar auto-hide (the tilde key) whenever gameplay starts; 0 leaves that
; setting alone.
SnapTurnHideQuickBar=1
; RightStickUp and RightStickDown under [Buttons] hold a target while the right
; stick is pushed up or down during gameplay. With SnapTurn=0, setting either one
; takes the stick's vertical axis for them; smooth turning keeps the horizontal.

; Optional button layout. [Buttons] applies to gameplay and scoped aiming,
; [ScreenButtons] to everything else: the title and pause menus, the in-game
; menu (map, objectives, inventory), the e-reader and news reader, terminals,
; hacking, videos, game over and loading screens.
; Omitted entries keep the stock layout. Inputs: RightA, RightB, LeftX, LeftY,
; LeftGrip, RightGrip, LeftStickClick, RightStickClick, LeftTrigger,
; RightTrigger. Targets: A B X Y LB RB LS RS LT RT Back Start DPadUp DPadDown
; DPadLeft DPadRight QuickSave None. QuickSave presses F5, the game's quicksave
; key, which has no gamepad binding. <Input>HoldMs=250 delays the target until the input
; has been held that long; with a delay set, <Input>Tap=A sends a short pulse
; when the input is released early.
[Buttons]

[ScreenButtons]
[Luma]
; Native Luma-shader port (sidesteps ReShade). Loads a hash-keyed shader
; replacement table from DeusExHRVR/shaders/dxhr/table.csv. Set to 0 to
; disable the whole subsystem; a missing or empty table is harmless.
; Match logging is always on when Enable=1; see DeusExHRVR-shaderswap.log.
Enable=1
; Actual pixel-shader substitution. Off by default for safety — flip on only
; after confirming (via the match log) that hashes resolve against the live
; game. F12 toggles this live without restarting. Substituted shaders are
; logged to DeusExHRVR-shaderswap.log and counted in the F8 camera log as
; 'substitutions='. Restart the game after changing this ini value.
SubstituteShaders=0

; Phase 3 — injected render passes (per-eye, sidesteps ReShade). All default
; off; enable individually after confirming the trigger hashes match. Counts
; appear in the F8 camera log as 'lumaPasses xegtao=N smaa=N modulate=N'.
; Restart the game after changing these.
; Native game ambient occlusion is retained; the XeGTAO experiment was withdrawn.
; SMAA: subpixel morphological AA replacing the game's MLAA. Phase 3e (stub —
; trigger detection only; full draw passes land in a later commit).
SMAAEnable=0
; ModulateLighting: adjust the completed lighting buffer before materials
; sample it, separately for each eye.
ModulateLightingEnable=0

; LumaSettings cbuffer values. These are passed to Luma's replacement + injected
; shaders at b13. Defaults match Luma's DXHR "not vanilla like" tuned values
; (main.cpp lines 1589-1599). Override to taste; restart to apply.
BloomIntensity=0.8
FogIntensity=0.0
ColorGradingIntensity=1.0
DesaturationIntensity=0.333
AmbientLightingIntensity=0.8
EmissiveIntensity=0.667
HDRBoostIntensity=1.0
; RGB multipliers; 1 is neutral. Lighting* requires ModulateLightingEnable=1.
LightingRed=1.0
LightingGreen=1.0
LightingBlue=1.0
AmbientRed=1.0
AmbientGreen=1.0
AmbientBlue=1.0

; Phase 4: overlap dedup. When on (default), Luma substitution is skipped for
; shaders DXHRVR already corrects per-eye (projected light/shadow via F3,
; identified at runtime via EffectShader::UsesCentreViewMatrix). Luma's mono
; replacements might not respect DXHRVR's per-eye transforms, so skipping
; avoids potential stereo conflicts. Also auto-skips Luma's SSAO generation
; replacement when XeGTAO is enabled (XeGTAO overwrites the result). Skipped
; hashes are logged to DeusExHRVR-shaderswap.log. Set to 0 to force Luma
; substitution everywhere (for testing).
DedupWithDXHRVR=1
